        <mapping class="com.newview.actpic.model.ActPic"/>
        <mapping class="com.newview.cityaddress.model.CityAddress"/>
        
        <mapping class="com.newview.pubuser.model.PubUserVO" />
        <mapping class="com.newview.publisher.model.PublisherVO" />
