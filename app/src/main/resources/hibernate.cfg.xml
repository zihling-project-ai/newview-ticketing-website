<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
		"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>
		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
		<property name="hibernate.connection.url">jdbc:mysql://127.0.0.1:3309/newview_recovery?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Taipei</property>
		<property name="hibernate.connection.password">LOCAL_CONFIGURATION_REQUIRED</property>
		<property name="hibernate.connection.username">newview</property>
		<property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

<!-- 		<property name="hibernate.show_sql">true</property> -->
		<property name="hibernate.format_sql">false</property>
		<property name="hibernate.hbm2ddl.auto">validate</property>
		<property name="hibernate.current_session_context_class">thread</property>
		
		<mapping class="com.newview.user.model.UserVO"/>
